{
  "mcpServers": {
    "typefully": {
      "command": "npx",
      "args": [
        "-y",
        "typefully-mcp-server"
      ],
      "env": {
        "TYPEFULLY_API_KEY": "${TYPEFULLY_API_KEY}"
      }
    },
    "google-search-console": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-server-gsc"
      ],
      "env": {
        "GOOGLE_APPLICATION_CREDENTIALS": "/Users/harjjotsinghh/.config/gcloud/application_default_credentials.json"
      }
    }
  }
}
