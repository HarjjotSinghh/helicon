{
  "name": "helicon",
  "displayName": "Helicon",
  "description": "Open-source GUI for the Muse Code CLI inside your editor: threads in a sidebar, approvals you can read, inline diffs, session history and usage. Uses your own muse login.",
  "version": "0.18.0",
  "publisher": "harjjotsinghh",
  "private": true,
  "license": "MIT",
  "icon": "media/icon.png",
  "homepage": "https://helicon.sh/?utm_source=vscode&utm_medium=listing&utm_campaign=extension",
  "repository": {
    "type": "git",
    "url": "https://github.com/HarjjotSinghh/helicon",
    "directory": "apps/vscode"
  },
  "bugs": {
    "url": "https://github.com/HarjjotSinghh/helicon/issues"
  },
  "galleryBanner": {
    "color": "#1A1A2E",
    "theme": "dark"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "muse code",
    "muse",
    "muse-code",
    "meta",
    "coding agent",
    "ai agent",
    "msp",
    "gui",
    "approvals",
    "session history"
  ],
  "engines": {
    "vscode": "^1.101.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "helicon.open",
        "title": "Open Helicon",
        "category": "Helicon",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "helicon.newThread",
        "title": "New Thread",
        "category": "Helicon",
        "icon": "$(add)"
      },
      {
        "command": "helicon.openInEditor",
        "title": "Open Full Helicon in Editor",
        "category": "Helicon",
        "icon": "$(link-external)"
      },
      {
        "command": "helicon.openForFolder",
        "title": "New Thread in This Folder",
        "category": "Helicon"
      },
      {
        "command": "helicon.openInBrowser",
        "title": "Open in Browser",
        "category": "Helicon"
      },
      {
        "command": "helicon.restart",
        "title": "Restart Server",
        "category": "Helicon"
      },
      {
        "command": "helicon.showLog",
        "title": "Show Log",
        "category": "Helicon"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "helicon",
          "title": "Helicon",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "helicon": [
        {
          "type": "webview",
          "id": "helicon.panel",
          "name": "Helicon"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "helicon.openInEditor",
          "when": "view == helicon.panel",
          "group": "navigation@2"
        }
      ],
      "explorer/context": [
        {
          "command": "helicon.openForFolder",
          "when": "explorerResourceIsFolder",
          "group": "navigation@90"
        }
      ]
    },
    "keybindings": [
      {
        "command": "helicon.open",
        "key": "ctrl+alt+h",
        "mac": "cmd+alt+h"
      }
    ],
    "configuration": {
      "title": "Helicon",
      "properties": {
        "helicon.panelBorder": {
          "type": "string",
          "enum": [
            "auto",
            "left",
            "right",
            "none"
          ],
          "default": "auto",
          "markdownDescription": "Which edge of the Helicon side panel gets a divider line. `auto` puts it on the edge facing the editor, going by `workbench.sideBar.location`; pick `left` or `right` if you moved Helicon to the other side bar.",
          "enumDescriptions": [
            "The edge facing the editor, based on the side bar's location",
            "Left edge",
            "Right edge",
            "No divider"
          ]
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "package": "node scripts/build.mjs && npx --yes @vscode/vsce@4.0.0 package --no-dependencies --out helicon.vsix",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs",
    "test:integration": "node scripts/build.mjs && node test/integration/run.mjs"
  },
  "devDependencies": {
    "@types/vscode": "~1.101.0",
    "@vscode/test-electron": "^3.1.0"
  },
  "extensionKind": [
    "workspace"
  ]
}
