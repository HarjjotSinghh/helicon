<?xml version="1.0" encoding="utf-8"?>
<!--
  SignPath artifact configuration for the Windows installer. The same XML is set as the default
  artifact configuration of the "helicon" project on app.signpath.io; keep the two in sync.
  GitHub zips every workflow artifact, so the root is a zip-file holding the one NSIS installer.
  The metadata restrictions stop anything but a Helicon build of the tagged version from being signed.
-->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="Helicon_${version}_x64-setup.exe" product-name="Helicon" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
